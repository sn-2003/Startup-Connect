model Incubator {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  description String
  location    String
  focusAreas  String[]
  website     String?
  applyLink   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("incubators")
}
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  website   String?
  linkedin  String?
  github    String?
  termsAgreedAt DateTime? // Track when user agreed to terms
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  startups      Startup[]
  resume        Resume?
  applications  Application[]
  savedJobs     SavedJob[]
  startupVotes  StartupVote[]
  startupFeedback StartupFeedback[]
  chatMessages  ChatMessage[]

  @@map("users")
}

model Startup {
  id          String   @id @default(cuid())
  name        String
  domain      String?
  stage       StartupStage
  description String
  logo        String?
  founded     String?
  location    String?
  employees   String?
  funding     String?
  website     String?
  industry    String
  upvotes     Int      @default(0)
  downvotes   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Social Media Links
  xUrl         String?
  instagramUrl String?
  linkedinUrl  String?
  promotionalImages String[] // Array of promotional image URLs

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs     Job[]
  votes    StartupVote[]
  feedback StartupFeedback[]

  @@map("startups")
}

model Job {
  id              String          @id @default(cuid())
  title           String
  location        String?
  type            JobType
  description     String
  requirements    String[]
  experienceLevel ExperienceLevel
  salaryMin       Int?
  salaryMax       Int?
  unpaid          Boolean         @default(false) // Whether the job is unpaid
  remote          Boolean         @default(false)
  listed          Boolean         @default(true)  // Whether the job is publicly visible
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  startupId       String
  startup         Startup           @relation(fields: [startupId], references: [id], onDelete: Cascade)
  customQuestions CustomQuestion[]
  applications    Application[]
  savedJobs       SavedJob[]

  @@map("jobs")
}

model CustomQuestion {
  id       String      @id @default(cuid())
  question String
  type     QuestionType
  required Boolean     @default(false)
  order    Int         @default(0)

  // Relations
  jobId   String
  job     Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers CustomAnswer[]

  @@map("custom_questions")
}

model Resume {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  bio        String?
  skills     String[]
  resumeText String?
  pdfUrl     String?  // URL to the PDF file in Supabase storage
  pdfFileName String? // Original filename of the uploaded PDF
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience     Experience[]
  education      Education[]
  customSections CustomSection[]

  @@map("resumes")
}

model Experience {
  id          String   @id @default(cuid())
  company     String
  position    String
  startDate   String
  endDate     String?
  current     Boolean  @default(false)
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

model Education {
  id          String   @id @default(cuid())
  institution String
  degree      String
  field       String
  startDate   String
  endDate     String
  gpa         String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("education")
}

model CustomSection {
  id        String   @id @default(cuid())
  title     String
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("custom_sections")
}

model Application {
  id             String            @id @default(cuid())
  status         ApplicationStatus @default(SUBMITTED)
  appliedAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Resume snapshot at time of application
  resumePdfUrl      String?
  resumePdfFileName String?

  // Relations
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String
  job          Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customAnswers CustomAnswer[]

  @@unique([userId, jobId])
  @@map("applications")
}

model CustomAnswer {
  id     String @id @default(cuid())
  answer String

  // Relations
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String
  question      CustomQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@map("custom_answers")
}

model SavedJob {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("saved_jobs")
}

model StartupVote {
  id        String   @id @default(cuid())
  type      VoteType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  startupId String
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([userId, startupId])
  @@map("startup_votes")
}

model StartupFeedback {
  id        String   @id @default(cuid())
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  startupId String
  startup   Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@map("startup_feedback")
}

model Investor {
  id             String   @id @default(cuid())
  name           String
  firm           String
  preferredStage String[]
  sectors        String[]
  geography      String[]
  description    String
  portfolio      String[]
  email          String
  linkedin       String?
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("investors")
}

model Resource {
  id          String       @id @default(cuid())
  title       String
  description String
  category    String
  type        String
  url         String
  imageUrl    String?
  featured    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("resources")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  sender    String   // 'user' or 'ai'
  text      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// Enums
enum StartupStage {
  IDEA
  MVP
  EARLY
  GROWTH
  SCALE

  @@map("startup_stage")
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP

  @@map("job_type")
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD

  @@map("experience_level")
}

enum QuestionType {
  TEXT
  TEXTAREA
  URL

  @@map("question_type")
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWED
  SHORTLISTED
  REJECTED

  @@map("application_status")
}

enum VoteType {
  UPVOTE
  DOWNVOTE

  @@map("vote_type")
}